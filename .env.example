# AI 智能客服系统环境变量配置模板
# 复制此文件为 .env 并填入实际值

# ============================================
# 数据库配置
# ============================================
POSTGRES_PASSWORD=REQUIRED_CHANGE_ME_POSTGRES_PASSWORD
REDIS_PASSWORD=REQUIRED_CHANGE_ME_REDIS_PASSWORD

# Fixed production image references. Update these together for a release.
APP_VERSION=1.0.0
POSTGRES_IMAGE=postgres:14.23-alpine@sha256:f1341c01408dc7278e9d365ed4f860cd3f87dd16b4464ac326fc0f422083a579
REDIS_IMAGE=redis:7.4.10-alpine@sha256:e7723ff73d963f5cc6d9c4643ea3d989527a402a319239054e9472a7fb9219a2
CHATWOOT_IMAGE=chatwoot/chatwoot:v3.11.0@sha256:f085e3339c70ba8fe2d8219a02c831cd823024a6c5ca5f23a143b77047d5485d
QDRANT_IMAGE=qdrant/qdrant:v1.18.3@sha256:0bd98fa7977f1e75694779359ca4e212822e5a71334e28421182f72f209d5286
PROMETHEUS_IMAGE=prom/prometheus:v3.13.2@sha256:508729e0e2d18e11fd742a5a5ca70e557b940a93948c3c95fd0123a6fd538b69
GRAFANA_IMAGE=grafana/grafana:13.1.2@sha256:d177053ab62253815f130d81504f77063baf5fd4ca93299d6048453bd31e047a

# ============================================
# Production HTTPS ingress (required only with docker-compose.production.yml)
# ============================================
# Use four distinct hosts under one registered base domain.
ADMIN_HOST=admin.example.com
AGENT_HOST=agent.example.com
WIDGET_HOST=widget.example.com
CHATWOOT_HOST=chat.example.com
ACME_EMAIL=ops@example.com
# Comma-separated IPv4/IPv6 addresses or CIDRs. Never use a catch-all range.
ADMIN_ALLOWED_CIDRS=203.0.113.10/32
HOST_BIND_ADDRESS=127.0.0.1
WIDGET_PUBLIC_BASE_URL=https://widget.example.com
# Must be a tag plus immutable sha256 digest resolved for the target platform.
CADDY_IMAGE=caddy:2.10.2-alpine@sha256:4c6e91c6ed0e2fa03efd5b44747b625fec79bc9cd06ac5235a779726618e530d

# ============================================
# Chatwoot 配置
# ============================================
CHATWOOT_FRONTEND_URL=http://localhost:3000
CHATWOOT_API_TOKEN=REQUIRED_CHANGE_ME_CHATWOOT_API_TOKEN
CHATWOOT_ACCOUNT_ID=1
SECRET_KEY_BASE=REQUIRED_CHANGE_ME_SECRET_KEY_BASE_MIN_128_CHARS

# ============================================
# AI Provider（标准版固定 local；增强版通过 docker-compose.dify.yml 切换）
# ============================================
AI_PROVIDER=local
DIFY_VERSION=1.16.1
DIFY_API_URL=http://host.docker.internal:5001/v1
DIFY_API_KEY=REQUIRED_CHANGE_ME_DIFY_API_KEY

# ============================================
# Bridge Service 配置
# ============================================
CONFIDENCE_THRESHOLD=0.7
LOG_LEVEL=INFO
SETUP_TOKEN=REQUIRED_CHANGE_ME_ONE_TIME_SETUP_TOKEN
CONFIG_ENCRYPTION_KEY=REQUIRED_CHANGE_ME_32_BYTE_HEX_CONFIG_ENCRYPTION_KEY

# Chatwoot 私有 Webhook Adapter（均至少 32 字节；不要复用其他密钥）
CHATWOOT_ADAPTER_INGRESS_TOKEN=REQUIRED_CHANGE_ME_PRIVATE_INGRESS_TOKEN_MIN_32_BYTES
CHATWOOT_WEBHOOK_SECRET=REQUIRED_CHANGE_ME_HMAC_SECRET_MIN_32_BYTES
WEBHOOK_ADAPTER_CONCURRENCY=8
WEBHOOK_ADAPTER_PREFETCH=64
WEBHOOK_ADAPTER_BUFFER_LIMIT=256
WEBHOOK_ADAPTER_SHUTDOWN_GRACE_SECONDS=30
WEBHOOK_ADAPTER_LEASE_TTL_SECONDS=15
WEBHOOK_ADAPTER_LEASE_RENEW_SECONDS=5

# ============================================
# 监控配置
# ============================================
GRAFANA_PASSWORD=REQUIRED_CHANGE_ME_GRAFANA_PASSWORD

# ============================================
# External ports and frontend build images
# ============================================
ADMIN_PORT=5175
AGENT_PORT=5174
BRIDGE_PORT=8000
CHATWOOT_PORT=3000
QDRANT_PORT=6333
POSTGRES_PORT=15432
REDIS_PORT_EXTERNAL=16379
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
NODE_IMAGE=node:20.19.4-alpine3.22@sha256:df02558528d3d3d0d621f112e232611aecfee7cbc654f6b375765f72bb262799
NGINX_IMAGE=nginx:1.29.1-alpine3.22@sha256:42a516af16b852e33b7682d5ef8acbd5d13fe08fecadc7ed98605ba5e3b26ab8

# ============================================
# 生成随机密钥的命令
# ============================================
# Linux/Mac: openssl rand -hex 64
# Python: python -c "import secrets; print(secrets.token_hex(64))"
