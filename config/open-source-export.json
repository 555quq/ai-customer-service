{
  "schema_version": 1,
  "include_roots": [
    ".github",
    "alertmanager",
    "bridge-service",
    "config",
    "deploy",
    "examples",
    "frontend",
    "grafana",
    "prometheus",
    "scripts",
    "webhook-adapter"
  ],
  "include_files": [
    ".env.example",
    ".gitignore",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "VERSION",
    "docker-compose.acceptance.yml",
    "docker-compose.dify.yml",
    "docker-compose.production.yml",
    "docker-compose.yml",
    "nginx.conf",
    "release-manifest.json",
    "docs/api.md",
    "docs/configuration.md",
    "docs/installation.md",
    "docs/operations.md",
    "docs/security-hardening.md",
    "docs/troubleshooting.md",
    "docs/widget-integration.md",
    "docs/release/acceptance-checklist.md",
    "docs/release/v1.0.0.md"
  ],
  "exclude_globs": [
    ".git/**",
    ".env",
    ".env.*",
    "!.env.example",
    "**/.env",
    "**/.env.*",
    "!**/.env.example",
    "**/.git/**",
    "**/.pytest_cache/**",
    "**/__pycache__/**",
    "**/*.pyc",
    "**/*.log",
    "**/*.log.*",
    "**/*.pid",
    "**/*.bak",
    "**/*.backup",
    "**/*.old",
    "**/backups/**",
    "**/diagnostics/**",
    "**/dist/**",
    "**/model_cache/**",
    "**/node_modules/**",
    "**/runtime/**",
    "bridge-service/config/audit.jsonl",
    "bridge-service/测试报告.md",
    "docs/superpowers/**",
    "examples/_*.md",
    "frontend/DESIGN_REVIEW.md"
  ],
  "required_files": [
    ".env.example",
    ".gitignore",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "VERSION",
    "docker-compose.yml",
    "release-manifest.json",
    "bridge-service/src/main.py",
    "frontend/package.json",
    "scripts/install.ps1",
    "docs/installation.md",
    "docs/configuration.md",
    "docs/widget-integration.md",
    "docs/operations.md",
    "docs/security-hardening.md",
    "docs/troubleshooting.md",
    "docs/api.md"
  ]
}
