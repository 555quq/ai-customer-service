# Bridge Service Configuration Template
# Copy this file to .env and fill in your actual values

# ============================================
# Chatwoot Configuration
# ============================================
CHATWOOT_BASE_URL=http://localhost:3000
CHATWOOT_API_TOKEN=your_chatwoot_api_token_here
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_WEBHOOK_SECRET=REQUIRED_CHANGE_ME_HMAC_SECRET_MIN_32_BYTES
WEBHOOK_ALLOW_LEGACY_V1=false
CHATWOOT_ADAPTER_GATEWAY_URL=http://webhook-gateway:8080
CHATWOOT_ADAPTER_INGRESS_TOKEN=REQUIRED_CHANGE_ME_PRIVATE_INGRESS_TOKEN_MIN_32_BYTES

# ============================================
# Dify AI Configuration
# ============================================
DIFY_API_URL=http://localhost:5001/v1
DIFY_API_KEY=REQUIRED_CHANGE_ME_DIFY_API_KEY

# ============================================
# AI Configuration
# ============================================
# local is the standard edition. Set dify only through the optional Compose overlay.
AI_PROVIDER=local
# Confidence threshold for automatic handoff to human (0.0 - 1.0)
CONFIDENCE_THRESHOLD=0.7
AI_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
AI_EMBEDDING_CACHE_DIR=data/model_cache
AI_EMBEDDING_DIMENSION=512

# ============================================
# Handoff Keywords (comma-separated)
# ============================================
# Messages containing these keywords will trigger automatic handoff
HANDOFF_KEYWORDS=["人工","转人工","人工客服","联系客服","投诉","退款","售后","经理"]

# ============================================
# Server Configuration
# ============================================
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
WIDGET_PUBLIC_BASE_URL=
WIDGET_HOST=

# ============================================
# Authentication
# ============================================
# Production requires a strong random JWT_SECRET, Argon2 password hashes,
# Secure cookies, an explicit Origin allowlist, and a reachable Redis service.
JWT_SECRET=REQUIRED_CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
CONFIG_ENCRYPTION_KEY=REQUIRED_CHANGE_ME_32_BYTE_HEX_CONFIG_ENCRYPTION_KEY
JWT_ISSUER=ai-customer-service-bridge
JWT_AUDIENCE=ai-customer-service-ui
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
WIDGET_TOKEN_HOURS=24
# Legacy shared cookie name is retained only so upgrades can delete it.
REFRESH_COOKIE_NAME=ai_cs_refresh
ADMIN_REFRESH_COOKIE_NAME=ai_cs_refresh_admin
AGENT_REFRESH_COOKIE_NAME=ai_cs_refresh_agent
AUTH_COOKIE_SECURE=false
AUTH_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175
ADMIN_USERNAME=admin
# Plaintext passwords are only an uninitialized local-development fallback.
ADMIN_PASSWORD=
# ADMIN_PASSWORD_HASH=$argon2id$...
AGENT_USERNAME=agent
AGENT_PASSWORD=
# AGENT_PASSWORD_HASH=$argon2id$...
ENABLE_DEV_API_KEY_COMPAT=false
KNOWLEDGE_UPLOAD_MAX_BYTES=10485760

# ============================================
# Redis Configuration (Optional - for future caching)
# ============================================
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
